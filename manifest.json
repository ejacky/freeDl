{
  "manifest_version": 3,
  "name": "FreeDl",
  "version": "1.0.0",
  "description": "下载当前网页的在线视频，支持m3u8格式",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "webRequest",
    "debugger",
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "http://localhost:*/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Video Downloader"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "debug.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "offscreen.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png"
  }
}